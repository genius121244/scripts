-- queue

local taskQueue = {}
local queueRunning = false

local function queueTask(fn)
    table.insert(taskQueue, fn)
end

local function runQueue()
    if queueRunning then return end
    queueRunning = true
    task.spawn(function()
        while #taskQueue > 0 do
            local fn = table.remove(taskQueue, 1)
            local ok, err = pcall(fn)
            if not ok then
                setStatus("ERR: " .. tostring(err):sub(1, 55))
                warn("[OilEmpireV5] " .. tostring(err))
            end
            task.wait(0.3)
        end
        queueRunning = false
    end)
end


-- auto sell

local function doAutoSell()
    local gas = getGas()
    if gas <= 0 then setStatus("No gas to sell") return end
    local price = GasPrice.Value
    if price < Settings.MinSellPrice then
        setStatus("Price $" .. price .. " < min $" .. Settings.MinSellPrice)
        return
    end
    savePos()
    local sellStore = workspace.Stores:FindFirstChild("Sell")
    if sellStore then
        local main = sellStore:FindFirstChild("Main")
        if main then
            local primary = main:FindFirstChild("Primary")
            if primary and primary:IsA("BasePart") then
                local r = getRootPart()
                if r then
                    r.CFrame = CFrame.new(primary.Position + Vector3.new(0, 3, 0))
                end
                task.wait(0.2)
            end
        end
    end
    SellGasRemote:FireServer()
    task.wait(0.2)
    setStatus("Sold " .. gas .. " gas @ $" .. price)
    returnPos()
end


-- auto collect

local lastCollect = 0
local function doAutoCollect()
    if tick() - lastCollect < 15 then return end
    lastCollect = tick()

    local myPlot = getMyPlot()
    if not myPlot then setStatus("Plot not found!") return end
    local buildings = myPlot:FindFirstChild("Buildings")
    if not buildings then return end

    local count = 0
    savePos()

    for _, building in pairs(buildings:GetChildren()) do
        if not isRefinery(building) then continue end
        local pp = getStealPP(building)
        if not pp then continue end
        local pos = getPPPos(pp)
        if not pos then continue end
        local r = getRootPart()
        if r then r.CFrame = CFrame.new(pos.X, pos.Y + 3, pos.Z) end
        task.wait(0.8)
        count += 1
    end

    returnPos()
    if count == 0 then
        setStatus("No refineries found")
    else
        setStatus("Collected from " .. count .. " refineries")
    end
end


-- auto steal (modified with 2 second delay before returning to base)

local stealCooldowns = {}
local function doAutoSteal()
    local enemies = getEnemyPlots()
    local stoleCount = 0

    for _, plot in pairs(enemies) do
        local pname = plot.Name
        if stealCooldowns[pname] and tick() - stealCooldowns[pname] < 25 then continue end

        local buildings = plot:FindFirstChild("Buildings")
        if not buildings then continue end

        local bestPP, bestAmt, bestBuilding = nil, 0, nil
        for _, building in pairs(buildings:GetChildren()) do
            if not isRefinery(building) then continue end
            local pp = getStealPP(building)
            if not pp then continue end
            if not pp.Enabled then continue end
            local amt = getStealAmount(pp)
            if amt > 0 and amt > bestAmt then
                bestAmt = amt
                bestPP = pp
                bestBuilding = building
            end
        end

        if bestPP and bestBuilding then
            savePos()
            setStatus("Stealing " .. bestAmt .. " gas from " .. pname)

            local stealPos = getPPPos(bestPP)
            if not stealPos then
                returnPos()
                continue
            end

            -- Tp to enemy refinery
            local r = getRootPart()
            if r then
                r.CFrame = CFrame.new(stealPos.X, stealPos.Y + 3, stealPos.Z)
            end
            task.wait(0.3)

            local oldDist = bestPP.MaxActivationDistance
            bestPP.MaxActivationDistance = 999

            local holdTime = bestPP.HoldDuration + math.random(1, 5) * 0.1
            local ok, err = pcall(fireproximityprompt, bestPP, holdTime)
            if not ok then warn("[Steal] " .. tostring(err)) end
            task.wait(holdTime + 0.5)

            bestPP.MaxActivationDistance = oldDist
            stealCooldowns[pname] = tick()
            stoleCount += 1

            -- Tp to own refinery to claim
            local myPlot = getMyPlot()
            if myPlot then
                local myBuildings = myPlot:FindFirstChild("Buildings")
                if myBuildings then
                    for _, b in pairs(myBuildings:GetChildren()) do
                        if not isRefinery(b) then continue end
                        local myPP = getStealPP(b)
                        if myPP then
                            local claimPos = getPPPos(myPP)
                            if claimPos then
                                local r2 = getRootPart()
                                if r2 then
                                    r2.CFrame = CFrame.new(
                                        claimPos.X, claimPos.Y + 3, claimPos.Z
                                    )
                                end
                                task.wait(0.6)
                            end
                        end
                        break
                    end
                end
            end

            
            returnPosWithDelay(.5)
        end
    end

    if stoleCount == 0 then
        local anyReady = false
        for _, plot in pairs(enemies) do
            local buildings = plot:FindFirstChild("Buildings")
            if buildings then
                for _, building in pairs(buildings:GetChildren()) do
                    if not isRefinery(building) then continue end
                    local pp = getStealPP(building)
                    if pp and pp.Enabled and getStealAmount(pp) > 0 then
                        anyReady = true break
                    end
                end
            end
            if anyReady then break end
        end
        setStatus(anyReady and "Steal on cooldown" or "Waiting for full refineries")
    else
        setStatus("Stole from " .. stoleCount .. " plot(s)")
    end
end


-- auto buy

local buyJobs = {
    { setting="AutoBuyDrill",    itemsKey="BuyDrillItems",    remoteKey="DrillShop",    storeName="Drill Shop"    },
    { setting="AutoBuyRefinery", itemsKey="BuyRefineryItems", remoteKey="RefineryShop", storeName="Refinery Shop" },
}

local buyStatus = {}

RS.Packages.Knit.Services.StoresService.RE.ReStock.OnClientEvent:Connect(function()
    for k in pairs(buyStatus) do buyStatus[k] = nil end
    setStatus("Shop restocked!")
end)

local function doAutoBuy()
    for _, job in pairs(buyJobs) do
        if not Settings[job.setting] then continue end
        local selectedItems = Settings[job.itemsKey]
        if not selectedItems or #selectedItems == 0 then continue end

        local anyToBuy = false
        for _, itemName in pairs(selectedItems) do
            if buyStatus[itemName] == "oos" then continue end
            local itemData = nil
            for _, item in pairs(getShopItems(job.remoteKey)) do
                if item.name == itemName then itemData = item break end
            end
            if itemData and getCash() >= parsePriceText(itemData.price) then
                anyToBuy = true break
            end
        end

        if not anyToBuy then
            for _, itemName in pairs(selectedItems) do
                if buyStatus[itemName] == "oos" then continue end
                local itemData = nil
                for _, item in pairs(getShopItems(job.remoteKey)) do
                    if item.name == itemName then itemData = item break end
                end
                if not itemData then
                    if buyStatus[itemName] ~= "oos" then
                        buyStatus[itemName] = "oos"
                        setStatus(itemName .. " out of stock")
                    end
                elseif getCash() < parsePriceText(itemData.price) then
                    if buyStatus[itemName] ~= "broke" then
                        buyStatus[itemName] = "broke"
                        setStatus("Can't afford " .. itemName)
                    end
                end
            end
            continue
        end

        savePos()
        local store = workspace.Stores:FindFirstChild(job.storeName)
        if store then
            local main = store:FindFirstChild("Main")
            if main then
                local primary = main:FindFirstChild("Primary")
                if primary and primary:IsA("BasePart") then
                    local r = getRootPart()
                    if r then
                        r.CFrame = CFrame.new(primary.Position + Vector3.new(0, 4, 0))
                    end
                    task.wait(0.15)
                end
            end
        end

        for _, itemName in pairs(selectedItems) do
            if buyStatus[itemName] == "oos" then continue end
            local itemData = nil
            for _, item in pairs(getShopItems(job.remoteKey)) do
                if item.name == itemName then itemData = item break end
            end
            if not itemData then
                if buyStatus[itemName] ~= "oos" then
                    buyStatus[itemName] = "oos"
                    setStatus(itemName .. " out of stock")
                end
                continue
            end
            local price = parsePriceText(itemData.price)
            if getCash() < price then
                if buyStatus[itemName] ~= "broke" then
                    buyStatus[itemName] = "broke"
                    setStatus("Can't afford " .. itemName)
                end
                continue
            end
            local maxToBuy = parseStock(itemData.stock)
            for i = 1, maxToBuy do
                if getCash() < price then
                    buyStatus[itemName] = "broke"
                    break
                end
                PurchaseRemote:FireServer(job.remoteKey, itemName)
                setStatus("Bought " .. i .. "/" .. maxToBuy .. "x " .. itemName)
                task.wait(0.2)
            end
            buyStatus[itemName] = "oos"
        end

        returnPos()
    end
end


