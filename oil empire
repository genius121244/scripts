-- plot

local function getMyPlotName()
    return player:GetAttribute("Plot")
end

local function getMyPlot()
    local name = getMyPlotName()
    if name then
        local p = workspace.Plots:FindFirstChild(name)
        if p then return p end
    end
    for _, plot in pairs(workspace.Plots:GetChildren()) do
        local ot = plot:FindFirstChild("OwnerTag")
        if ot then
            for _, v in pairs(ot:GetDescendants()) do
                if v:IsA("TextLabel") and v.Text == player.Name .. "'s Base" then
                    return plot
                end
            end
        end
    end
end

local function getEnemyPlots()
    local list = {}
    local myName = getMyPlotName()
    for _, plot in pairs(workspace.Plots:GetChildren()) do
        if plot.Name == myName then continue end
        local ot = plot:FindFirstChild("OwnerTag")
        if ot then
            for _, v in pairs(ot:GetDescendants()) do
                if v:IsA("TextLabel") and v.Text:find("'s Base") and v.Text ~= "YOUR BASE" then
                    table.insert(list, plot)
                    break
                end
            end
        end
    end
    return list
end


