-- help func 

local function getRootPart()
    local c = player.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local savedPos = nil

local function savePos()
    local r = getRootPart()
    if r then savedPos = r.CFrame end
end

local function returnPos()
    local r = getRootPart()
    if r and savedPos then
        r.CFrame = savedPos
        task.wait(0.1)
    end
end

local function returnPosWithDelay(delay)
    task.wait(delay)
    local r = getRootPart()
    if r and savedPos then
        r.CFrame = savedPos
        task.wait(0.1)
    end
end

local function tpTo(pos)
    local r = getRootPart()
    if r then
        r.CFrame = CFrame.new(pos)
        task.wait(0.2)
    end
end

local function getCash()
    local ls = player:FindFirstChild("leaderstats")
    return ls and ls:FindFirstChild("Cash") and ls.Cash.Value or 0
end

local function getGas()
    local ls = player:FindFirstChild("leaderstats")
    return ls and ls:FindFirstChild("Gasoline") and ls.Gasoline.Value or 0
end

local function isRefinery(building)
    local primary = building:FindFirstChild("Primary")
    if not primary then return false end
    return primary:FindFirstChild("StealAtc") ~= nil
end

local function getStealPP(building)
    local primary = building:FindFirstChild("Primary")
    if not primary then return nil end
    local stealAtc = primary:FindFirstChild("StealAtc")
    if not stealAtc then return nil end
    return stealAtc:FindFirstChildOfClass("ProximityPrompt")
end

local function getStealAmount(pp)
    if not pp then return 0 end
    local amt = pp.ActionText:match("%((%d+) gasoline%)")
    return tonumber(amt) or 0
end

local function getPPPos(pp)
    if not pp then return nil end
    local parent = pp.Parent
    if parent:IsA("Attachment") then return parent.WorldPosition
    elseif parent:IsA("BasePart") then return parent.Position end
    local p = parent.Parent
    while p do
        if p:IsA("BasePart") then return p.Position end
        p = p.Parent
    end
    return nil
end


-- price parser

local function parsePriceText(text)
    local clean = text:gsub("[$,]", ""):upper()
    local num, suffix = clean:match("^([%d%.]+)([KMBT]?)$")
    if not num then return 0 end
    local val = tonumber(num) or 0
    if suffix == "K" then val = val * 1e3
    elseif suffix == "M" then val = val * 1e6
    elseif suffix == "B" then val = val * 1e9
    elseif suffix == "T" then val = val * 1e12 end
    return val
end

local function parseStock(stockText)
    local n = stockText:match("X(%d+)")
    return tonumber(n) or 1
end


-- item reader

local function getShopItems(guiName)
    local items = {}
    local gui = player.PlayerGui:FindFirstChild("Main")
    if not gui then return items end
    local shop = gui:FindFirstChild(guiName)
    if not shop then return items end
    local list = shop:FindFirstChild("List")
    if not list then return items end

    for _, item in pairs(list:GetChildren()) do
        if item.Name == "Template" or item.Name == "Sekme" then continue end
        local buttons = item:FindFirstChild("Buttons")
        if not buttons then continue end
        local buyBtn = buttons:FindFirstChild("Buy")
        if not buyBtn then continue end
        local priceLabel = buyBtn:FindFirstChild("TextLabel")
        if not priceLabel then continue end
        local price = priceLabel.Text
        if price == "N/A" or price == "" then continue end
        local stockLabel = item:FindFirstChild("Stock")
        local stock = stockLabel and stockLabel.Text or "?"
        if stock:find("X0") or stock == "Limited Time" then continue end
        local vp = item:FindFirstChild("ViewportFrame")
        local nameLabel = vp and vp:FindFirstChild("ItemName")
        local itemName = (nameLabel and nameLabel.Text ~= ""
            and nameLabel.Text ~= "[PARTNAME]")
            and nameLabel.Text or item.Name
        table.insert(items, {
            name     = itemName,
            price    = price,
            priceVal = parsePriceText(price),
            stock    = stock,
        })
    end

    table.sort(items, function(a, b) return a.priceVal < b.priceVal end)
    return items
end


